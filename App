#!/usr/bin/env python3
"""Meadow House Repairs - standard-library-only Python web app.
Run: python3 app.py   then open http://127.0.0.1:8000
Jobs are saved to jobs.json next to this file (fictional data only)."""
import html, json, os, threading
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "jobs.json")
HOUSE = "Meadow House"
STATUSES = ["New", "In Progress", "Completed"]
LOCK = threading.Lock()


def load():
    try:
        with open(DATA, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, list) else []
    except (OSError, ValueError):
        return []


def save(jobs):
    tmp = DATA + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(jobs, f, indent=2)
    os.replace(tmp, DATA)


def now():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def fmt(iso):
    return datetime.fromisoformat(iso).strftime("%d %b %Y, %H:%M:%S")


def e(s):
    return html.escape(str(s), quote=True)


def next_id(jobs):
    n = 0
    for j in jobs:
        try:
            n = max(n, int(j["id"].split("-")[1]))
        except (ValueError, IndexError, KeyError):
            pass
    return "MH-%04d" % (n + 1)


def latest_note(j):
    for h in reversed(j["history"]):
        if h.get("note"):
            return h
    return None


def note_label(h):
    return "Completion note" if h["status"] == "Completed" else "Progress note"


