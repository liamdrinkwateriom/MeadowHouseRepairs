JS = "var r=document.getElementById('result');if(r){r.focus();}"


def page(title, body):
    return ("<!doctype html><html lang='en-GB'><head><meta charset='utf-8'>"
            "<meta name='viewport' content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body>"
            "<header><h1>Meadow House Repairs</h1>"
            "<p class='sub'>Report a repair, follow its progress and see what was done.</p></header>"
            "<main>%s</main><script>%s</script></body></html>" % (e(title), CSS, body, JS))


def badges(j):
    st = "done" if j["status"] == "Completed" else ""
    pr = "urgent" if j["priority"] == "Urgent" else ""
    return ("<span class='badge %s'>Status: %s</span><span class='badge %s'>%s priority</span>"
            % (st, e(j["status"]), pr, e(j["priority"])))


def note_block(j):
    n = latest_note(j)
    if not n:
        return ""
    return "<div class='note'><strong>%s:</strong> %s</div>" % (
        "Latest note (%s)" % note_label(n) if n["status"] != "Completed" else "Completion note", e(n["note"]))


def err_p(fid, msg):
    return "<p class='err' id='%s-err'>%s</p>" % (fid, e(msg or ""))


def inv(msg):
    return " aria-invalid='true'" if msg else ""


def summary(errs, title):
    if not errs:
        return ""
    items = "".join("<li>%s</li>" % e(m) for m in errs.values())
    return ("<div id='result' class='summary' role='alert' tabindex='-1'>%s<ul>%s</ul></div>" % (e(title), items))


def home(v=None, errs=None, notice=None):
    v, errs = v or {}, errs or {}
    jobs = load()
    prio = v.get("priority", "Normal")
    form = """
<section class='panel' aria-labelledby='rh'><h2 id='rh'>Report a repair</h2>
%s<form method='post' action='/report' novalidate>
<div class='field'><label for='desc'>Repair description</label>
<textarea id='desc' name='description' aria-describedby='desc-err'%s>%s</textarea>%s</div>
<div class='field'><label for='reporter'>Reporter name</label>
<input id='reporter' name='reporter' type='text' value='%s' aria-describedby='reporter-err'%s>%s</div>
<div class='field'><label for='prio'>Priority</label>
<select id='prio' name='priority'><option%s>Normal</option><option%s>Urgent</option></select></div>
<button type='submit'>Submit report</button></form></section>""" % (
        summary(errs, "Report not saved. Fix the following:"),
        inv(errs.get("description")), e(v.get("description", "")), err_p("desc", errs.get("description")),
        e(v.get("reporter", "")), inv(errs.get("reporter")), err_p("reporter", errs.get("reporter")),
        " selected" if prio == "Normal" else "", " selected" if prio == "Urgent" else "")
    note = ""
    if notice:
        note = "<div id='result' class='notice' role='status' tabindex='-1'>%s</div>" % e(notice)
    if jobs:
        items = ""
        for j in reversed(jobs):
            items += ("<li class='job'><div class='head'><h3>Job %s</h3>%s</div>"
                      "<dl><dt>House</dt><dd>%s</dd><dt>Reported</dt><dd>%s</dd><dt>Reporter</dt><dd>%s</dd>"
                      "<dt>Description</dt><dd>%s</dd></dl>%s<a href='/job/%s'>Open job %s</a></li>" % (
                          e(j["id"]), badges(j), e(j["house"]), e(fmt(j["created"])), e(j["reporter"]),
                          e(j["description"]), note_block(j), e(j["id"]), e(j["id"])))
        listing = "<ul class='jobs'>%s</ul>" % items
    else:
        listing = "<p class='empty'>No repair jobs yet. Use the form to report the first repair.</p>"
    body = "<div class='grid'>%s<section aria-labelledby='jh'><h2 id='jh'>Repair jobs</h2>%s%s</section></div>" % (
        form, note, listing)
    return page("Meadow House Repairs", body)


def detail(j, v=None, errs=None, notice=None):
    v, errs = v or {}, errs or {}
    cur = v.get("status", j["status"])
    note = ""
    if notice:
        note = "<div id='result' class='notice' role='status' tabindex='-1'>%s</div>" % e(notice)
    hist = ""
    for h in j["history"]:
        txt = "<strong>%s</strong>" % e(h["label"])
        if h.get("note"):
            txt += " &ndash; %s: %s" % (e(note_label(h)), e(h["note"]))
        hist += "<li><time datetime='%s'>%s</time> %s</li>" % (e(h["at"]), e(fmt(h["at"])), txt)
    form = ""
    if j["status"] != "Completed":
        opts = "".join("<option%s>%s</option>" % (" selected" if s == cur else "", s) for s in STATUSES)
        form = """<section aria-labelledby='uh'><h4 id='uh'>Update this job</h4>%s
<form method='post' action='/job/%s/update' novalidate>
<div class='field'><label for='status'>Status</label><select id='status' name='status'>%s</select></div>
<div class='field'><label for='note'>Note</label>
<textarea id='note' name='note' aria-describedby='note-hint note-err'%s>%s</textarea>
<p class='hint' id='note-hint'>Add a progress note. A completion note is required when the status is Completed.</p>%s</div>
<button type='submit'>Save update</button></form></section>""" % (
            summary(errs, "Update not saved. Fix the following:"), e(j["id"]), opts,
            inv(errs.get("note")), e(v.get("note", "")), err_p("note", errs.get("note")))
    body = ("<p><a href='/'>Back to all jobs</a></p>%s<article class='job' aria-labelledby='dh'>"
            "<div class='head'><h2 id='dh'>Job %s</h2>%s</div>"
            "<dl><dt>House</dt><dd>%s</dd><dt>Reported</dt><dd>%s</dd><dt>Reporter</dt><dd>%s</dd>"
            "<dt>Description</dt><dd>%s</dd></dl>%s%s"
            "<h4>History</h4><ol class='hist'>%s</ol></article>") % (
        note, e(j["id"]), badges(j), e(j["house"]), e(fmt(j["created"])), e(j["reporter"]),
        e(j["description"]), note_block(j), form, hist)
    return page("Job " + j["id"], body)


class H(BaseHTTPRequestHandler):
    def send(self, body, code=200):
        b = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def redirect(self, loc):
        self.send_response(303)
        self.send_header("Location", loc)
        self.end_headers()

    def find(self, jid):
        return next((j for j in load() if j["id"] == jid), None)

    def do_GET(self):
        u = urlparse(self.path)
        qs = parse_qs(u.query)
        parts = [p for p in u.path.split("/") if p]
        if not parts:
            notice = None
            cid = qs.get("created", [""])[0]
            j = self.find(cid) if cid else None
            if j:
                notice = "Job %s saved as New with %s priority." % (j["id"], j["priority"])
            return self.send(home(notice=notice))
        if len(parts) == 2 and parts[0] == "job":
            j = self.find(parts[1])
            if j:
                n = "Job %s saved. Status is %s." % (j["id"], j["status"]) if qs.get("saved") else None
                return self.send(detail(j, notice=n))
        self.send(page("Not found", "<p>Page not found. <a href='/'>Back to all jobs</a></p>"), 404)

    def form(self):
        n = min(int(self.headers.get("Content-Length") or 0), 1_000_000)
        raw = self.rfile.read(n).decode("utf-8", "replace")
        return {k: v[0].replace("\r\n", "\n") for k, v in parse_qs(raw, keep_blank_values=True).items()}

    def do_POST(self):
        parts = [p for p in urlparse(self.path).path.split("/") if p]
        f = self.form()
        with LOCK:
            if parts == ["report"]:
                d, r = f.get("description", ""), f.get("reporter", "")
                p = f.get("priority", "Normal")
                p = p if p in ("Normal", "Urgent") else "Normal"
                errs = {}
                if not d.strip():
                    errs["description"] = "Enter a description of the repair. It cannot be empty or only spaces."
                if not r.strip():
                    errs["reporter"] = "Enter the reporter name. It cannot be empty or only spaces."
                if errs:
                    return self.send(home({"description": d, "reporter": r, "priority": p}, errs))
                jobs = load()
                t = now()
                j = {"id": next_id(jobs), "house": HOUSE, "description": d.strip(), "reporter": r.strip(),
                     "priority": p, "status": "New", "created": t,
                     "history": [{"at": t, "status": "New", "label": "Job created as New", "note": ""}]}
                jobs.append(j)
                save(jobs)
                return self.redirect("/?created=" + j["id"])
            if len(parts) == 3 and parts[0] == "job" and parts[2] == "update":
                jobs = load()
                j = next((x for x in jobs if x["id"] == parts[1]), None)
                if not j:
                    return self.send(page("Not found", "<p>Job not found.</p>"), 404)
                st, note = f.get("status", ""), f.get("note", "").strip()
                errs = {}
                if j["status"] == "Completed":
                    errs["note"] = "This job is already Completed."
                elif st not in STATUSES:
                    errs["note"] = "Choose a valid status."
                elif st == "Completed" and not note:
                    errs["note"] = ("Enter a completion note to mark this job Completed. It cannot be empty or only "
                                    "spaces. The job is still %s." % j["status"])
                elif st == j["status"] and not note:
                    errs["note"] = "Add a note or choose a different status. There is nothing to save."
                if errs:
                    return self.send(detail(j, {"status": st, "note": f.get("note", "")}, errs))
                label = "Status: %s" % st if st != j["status"] else "Status stays %s" % st
                j["status"] = st
                j["history"].append({"at": now(), "status": st, "label": label, "note": note})
                save(jobs)
                return self.redirect("/job/%s?saved=1" % j["id"])
        self.send(page("Not found", "<p>Not found.</p>"), 404)

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    port = int(os.environ.get("PORT", "8000"))
    print("Meadow House Repairs running at http://127.0.0.1:%d (Ctrl+C to stop)" % port)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
